{
  "name": "session-peer",
  "version": "0.1.0-preview.0",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "preview"
  },
  "repository": { "type": "git", "url": "git+https://github.com/abruption/session-peer-ts.git" },
  "os": ["darwin", "linux", "win32"],
  "description": "Python-free local and SSH client for Claude Code and Codex sessions (preview)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "bin": {
    "session-peer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "README.ja.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "SECURITY.md",
    "VALIDATION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:windows": "npm run build && node --experimental-strip-types --test test/windows.test.ts",
    "test:package": "npm run build && node test/package-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "fs-ext-extra-prebuilt": "2.2.14"
  }
}
